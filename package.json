{
  "name": "pictogram-maker",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "deploy": "gh-pages -d dist --dotfiles",
    "lint": "oxlint",
    "test": "vitest run",
    "accounts": "node scripts/manage-accounts.mjs list",
    "add-account": "node scripts/manage-accounts.mjs add",
    "personas": "node scripts/manage-personas.mjs list",
    "personas:restore": "node scripts/manage-personas.mjs restore",
    "slice:sheet": "python3 scripts/slice-sheet-2x10.py",
    "pack:sheet": "python3 scripts/pack-sheet-2x10.py"
  },
  "dependencies": {
    "html2canvas": "^1.4.1",
    "html2canvas-pro": "^2.5.0",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.57.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "gh-pages": "^6.3.0",
    "jsdom": "^30.1.3",
    "oxlint": "^1.81.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.5"
  }
}
